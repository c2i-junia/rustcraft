// The recipes, what a furnace smelts and burns, and the families of items (tags) they take, named
// as the commands name the items, a family as `#planks`. The recipes are tried in the order of
// the files, then of each file. The fields are those of `RecipeDef` in
// `shared/src/content/recipes.rs`.
(
    tags: {
        "planks": ["oak_planks", "spruce_planks", "jungle_planks", "willow_planks", "acacia_planks"],
        "cobble": ["cobblestone", "cobbled_gloomrock"],
        "wool": ["wool", "orange_wool", "magenta_wool", "light_blue_wool", "yellow_wool", "lime_wool", "pink_wool", "gray_wool", "light_gray_wool", "cyan_wool", "purple_wool", "blue_wool", "brown_wool", "green_wool", "red_wool", "black_wool"],
        "raw_fish": ["raw_roach", "raw_perch", "raw_pike", "raw_eel", "raw_glowfin"],
        "roast_meat": ["roast_mutton", "roast_pork", "roast_beef", "roast_chicken", "roast_rabbit"],
    },
    recipes: [
        (out: "oak_planks", count: 4, pattern: ["O"], key: {'O': "oak_log"}),
        (out: "spruce_planks", count: 4, pattern: ["S"], key: {'S': "spruce_log"}),
        (out: "jungle_planks", count: 4, pattern: ["J"], key: {'J': "jungle_log"}),
