        (out: "wooden_pickaxe", pattern: ["PPP", " S ", " S "], key: {'P': "#planks", 'S': "stick"}),
        (out: "wooden_axe", pattern: ["PP", "PS", " S"], key: {'P': "#planks", 'S': "stick"}),
        (out: "wooden_shovel", pattern: ["P", "S", "S"], key: {'P': "#planks", 'S': "stick"}),
        (out: "wooden_hoe", pattern: ["PP", " S", " S"], key: {'P': "#planks", 'S': "stick"}),
