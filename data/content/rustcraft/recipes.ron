// The recipes, what a furnace smelts and burns, and the families of items (tags) they take, named
// as the commands name the items, a family as `#planks`. The recipes are tried in the order of
// the files, then of each file. The fields are those of `RecipeDef` in
// `shared/src/content/recipes.rs`.
(
    tags: {
        "cobble": ["cobblestone", "cobbled_gloomrock"],
        "raw_fish": ["raw_roach", "raw_perch", "raw_pike", "raw_eel", "raw_glowfin"],
        "roast_meat": ["roast_mutton", "roast_pork", "roast_beef", "roast_chicken", "roast_rabbit"],
    },
    recipes: [
        // terracotta, which the dyes of `palette_dyes.ron` colour
        (out: "terracotta", count: 2, shapeless: ["clay", "fired_brick"]),
        // The maps: paper from reeds, the empty map, its copy (the map drawn stays in the grid),
        // the compass and the frame
        (out: "paper", count: 3, pattern: ["RRR"], key: {'R': "reed"}),
        (out: "empty_map", pattern: ["PPP", "PCP", "PPP"], key: {'P': "paper", 'C': "coal"}),
        (out: "empty_map", pattern: ["PPP", "PCP", "PPP"], key: {'P': "paper", 'C': "charcoal"}),
        (out: "filled_map", shapeless: ["filled_map", "empty_map"]),
        (out: "compass", pattern: [" I ", "ICI", " I "], key: {'I': "iron_ingot", 'C': "copper_ingot"}),
        (out: "map_frame", pattern: ["SSS", "SLS", "SSS"], key: {'S': "stick", 'L': "leather"}),
        // The furniture: bedrolls, carpets, banners and lanterns of each colour, tables and chairs
        // of each wood, the book, the bookshelf, the flower pot, the item frame and the paintings
        (out: "white_bedroll", pattern: ["WWW", "R R"], key: {'W': "wool", 'R': "rope"}),
        (out: "white_carpet", count: 3, pattern: ["WW"], key: {'W': "wool"}),
        (out: "white_banner", pattern: ["WWW", "WWW", " S "], key: {'W': "wool", 'S': "stick"}),
        (out: "white_lantern", shapeless: ["lantern", "white_dye"]),
        (out: "orange_bedroll", pattern: ["OOO", "R R"], key: {'O': "orange_wool", 'R': "rope"}),
        (out: "orange_carpet", count: 3, pattern: ["OO"], key: {'O': "orange_wool"}),
        (out: "orange_banner", pattern: ["OOO", "OOO", " S "], key: {'O': "orange_wool", 'S': "stick"}),
        (out: "orange_lantern", shapeless: ["lantern", "orange_dye"]),
        (out: "magenta_bedroll", pattern: ["MMM", "R R"], key: {'M': "magenta_wool", 'R': "rope"}),
        (out: "magenta_carpet", count: 3, pattern: ["MM"], key: {'M': "magenta_wool"}),
        (out: "magenta_banner", pattern: ["MMM", "MMM", " S "], key: {'M': "magenta_wool", 'S': "stick"}),
        (out: "magenta_lantern", shapeless: ["lantern", "magenta_dye"]),
        (out: "light_blue_bedroll", pattern: ["LLL", "R R"], key: {'L': "light_blue_wool", 'R': "rope"}),
        (out: "light_blue_carpet", count: 3, pattern: ["LL"], key: {'L': "light_blue_wool"}),
        (out: "light_blue_banner", pattern: ["LLL", "LLL", " S "], key: {'L': "light_blue_wool", 'S': "stick"}),
        (out: "light_blue_lantern", shapeless: ["lantern", "light_blue_dye"]),
        (out: "yellow_bedroll", pattern: ["YYY", "R R"], key: {'Y': "yellow_wool", 'R': "rope"}),
        (out: "yellow_carpet", count: 3, pattern: ["YY"], key: {'Y': "yellow_wool"}),
        (out: "yellow_banner", pattern: ["YYY", "YYY", " S "], key: {'Y': "yellow_wool", 'S': "stick"}),
        (out: "yellow_lantern", shapeless: ["lantern", "yellow_dye"]),
        (out: "lime_bedroll", pattern: ["LLL", "R R"], key: {'L': "lime_wool", 'R': "rope"}),
        (out: "lime_carpet", count: 3, pattern: ["LL"], key: {'L': "lime_wool"}),
        (out: "lime_banner", pattern: ["LLL", "LLL", " S "], key: {'L': "lime_wool", 'S': "stick"}),
        (out: "lime_lantern", shapeless: ["lantern", "lime_dye"]),
        (out: "pink_bedroll", pattern: ["PPP", "R R"], key: {'P': "pink_wool", 'R': "rope"}),
        (out: "pink_carpet", count: 3, pattern: ["PP"], key: {'P': "pink_wool"}),
        (out: "pink_banner", pattern: ["PPP", "PPP", " S "], key: {'P': "pink_wool", 'S': "stick"}),
        (out: "pink_lantern", shapeless: ["lantern", "pink_dye"]),
        (out: "gray_bedroll", pattern: ["GGG", "R R"], key: {'G': "gray_wool", 'R': "rope"}),
        (out: "gray_carpet", count: 3, pattern: ["GG"], key: {'G': "gray_wool"}),
        (out: "gray_banner", pattern: ["GGG", "GGG", " S "], key: {'G': "gray_wool", 'S': "stick"}),
        (out: "gray_lantern", shapeless: ["lantern", "gray_dye"]),
        (out: "light_gray_bedroll", pattern: ["LLL", "R R"], key: {'L': "light_gray_wool", 'R': "rope"}),
        (out: "light_gray_carpet", count: 3, pattern: ["LL"], key: {'L': "light_gray_wool"}),
        (out: "light_gray_banner", pattern: ["LLL", "LLL", " S "], key: {'L': "light_gray_wool", 'S': "stick"}),
        (out: "light_gray_lantern", shapeless: ["lantern", "light_gray_dye"]),
        (out: "cyan_bedroll", pattern: ["CCC", "R R"], key: {'C': "cyan_wool", 'R': "rope"}),
        (out: "cyan_carpet", count: 3, pattern: ["CC"], key: {'C': "cyan_wool"}),
        (out: "cyan_banner", pattern: ["CCC", "CCC", " S "], key: {'C': "cyan_wool", 'S': "stick"}),
        (out: "cyan_lantern", shapeless: ["lantern", "cyan_dye"]),
        (out: "purple_bedroll", pattern: ["PPP", "R R"], key: {'P': "purple_wool", 'R': "rope"}),
        (out: "purple_carpet", count: 3, pattern: ["PP"], key: {'P': "purple_wool"}),
        (out: "purple_banner", pattern: ["PPP", "PPP", " S "], key: {'P': "purple_wool", 'S': "stick"}),
        (out: "purple_lantern", shapeless: ["lantern", "purple_dye"]),
        (out: "blue_bedroll", pattern: ["BBB", "R R"], key: {'B': "blue_wool", 'R': "rope"}),
        (out: "blue_carpet", count: 3, pattern: ["BB"], key: {'B': "blue_wool"}),
        (out: "blue_banner", pattern: ["BBB", "BBB", " S "], key: {'B': "blue_wool", 'S': "stick"}),
        (out: "blue_lantern", shapeless: ["lantern", "blue_dye"]),
        (out: "brown_bedroll", pattern: ["BBB", "R R"], key: {'B': "brown_wool", 'R': "rope"}),
        (out: "brown_carpet", count: 3, pattern: ["BB"], key: {'B': "brown_wool"}),
        (out: "brown_banner", pattern: ["BBB", "BBB", " S "], key: {'B': "brown_wool", 'S': "stick"}),
        (out: "brown_lantern", shapeless: ["lantern", "brown_dye"]),
        (out: "green_bedroll", pattern: ["GGG", "R R"], key: {'G': "green_wool", 'R': "rope"}),
        (out: "green_carpet", count: 3, pattern: ["GG"], key: {'G': "green_wool"}),
        (out: "green_banner", pattern: ["GGG", "GGG", " S "], key: {'G': "green_wool", 'S': "stick"}),
        (out: "green_lantern", shapeless: ["lantern", "green_dye"]),
        (out: "red_carpet", count: 3, pattern: ["RR"], key: {'R': "red_wool"}),
        (out: "red_banner", pattern: ["RRR", "RRR", " S "], key: {'R': "red_wool", 'S': "stick"}),
        (out: "red_lantern", shapeless: ["lantern", "red_dye"]),
        (out: "black_bedroll", pattern: ["BBB", "R R"], key: {'B': "black_wool", 'R': "rope"}),
        (out: "black_carpet", count: 3, pattern: ["BB"], key: {'B': "black_wool"}),
        (out: "black_banner", pattern: ["BBB", "BBB", " S "], key: {'B': "black_wool", 'S': "stick"}),
        (out: "black_lantern", shapeless: ["lantern", "black_dye"]),
        (out: "oak_table", pattern: ["OOO", "S S"], key: {'O': "oak_planks", 'S': "stick"}),
        (out: "oak_chair", count: 2, pattern: ["S  ", "OOO", "S S"], key: {'S': "stick", 'O': "oak_planks"}),
        (out: "spruce_table", pattern: ["SSS", "T T"], key: {'S': "spruce_planks", 'T': "stick"}),
        (out: "spruce_chair", count: 2, pattern: ["S  ", "PPP", "S S"], key: {'S': "stick", 'P': "spruce_planks"}),
        (out: "jungle_table", pattern: ["JJJ", "S S"], key: {'J': "jungle_planks", 'S': "stick"}),
        (out: "jungle_chair", count: 2, pattern: ["S  ", "JJJ", "S S"], key: {'S': "stick", 'J': "jungle_planks"}),
        (out: "willow_table", pattern: ["WWW", "S S"], key: {'W': "willow_planks", 'S': "stick"}),
        (out: "willow_chair", count: 2, pattern: ["S  ", "WWW", "S S"], key: {'S': "stick", 'W': "willow_planks"}),
        (out: "acacia_table", pattern: ["AAA", "S S"], key: {'A': "acacia_planks", 'S': "stick"}),
        (out: "acacia_chair", count: 2, pattern: ["S  ", "AAA", "S S"], key: {'S': "stick", 'A': "acacia_planks"}),
        (out: "book", shapeless: ["paper", "paper", "paper", "leather"]),
        (out: "bookshelf", pattern: ["PPP", "BBB", "PPP"], key: {'P': "#planks", 'B': "book"}),
        (out: "flower_pot", pattern: ["F F", " F "], key: {'F': "fired_brick"}),
        (out: "item_frame", pattern: ["SSS", "SWS", "SSS"], key: {'S': "stick", 'W': "#wool"}),
        (out: "painting", pattern: ["SSS", "SPS", "SSS"], key: {'S': "stick", 'P': "paper"}),
        (out: "wide_painting", pattern: ["PP"], key: {'P': "painting"}),
        // Alchemy: the alembic and the glass vials
        (out: "alembic", pattern: [" G ", "CGC", "OOO"], key: {'G': "glass", 'C': "copper_ingot", 'O': "#cobble"}),
        (out: "glass_vial", count: 3, pattern: ["G G", " G "], key: {'G': "glass"}),
    ],
    smelting: [
        ("sand", "glass"),
        ("cactus", "green_dye"),
        ("cobblestone", "stone"),
        ("iron_ore", "iron_ingot"),
        ("gold_ore", "gold_ingot"),
        ("diamond_ore", "diamond"),
        ("clay", "fired_brick"),
        ("copper_ore", "copper_ingot"),
        ("tin_ore", "tin_ingot"),
        ("mushroom", "roast_mushroom"),
        ("raw_mutton", "roast_mutton"),
        ("raw_pork", "roast_pork"),
        ("raw_beef", "roast_beef"),
        ("raw_chicken", "roast_chicken"),
        ("raw_rabbit", "roast_rabbit"),
        ("potato", "baked_potato"),
        ("cobbled_gloomrock", "gloomrock"),
        ("raw_roach", "grilled_roach"),
        ("raw_perch", "grilled_perch"),
        ("raw_pike", "grilled_pike"),
        ("raw_eel", "grilled_eel"),
        ("raw_glowfin", "grilled_glowfin"),
        ("egg", "fried_egg"),
        ("cake_batter", "cocoa_cake"),
        ("raw_pie", "apple_pie"),
    ],
    fuel: {
        "#planks": 300,
        "stick": 100,
        "crafting_table": 300,
        "chest": 300,
        "wooden_pickaxe": 200,
        "wooden_axe": 200,
        "wooden_shovel": 200,
        "wooden_hoe": 200,
        "wooden_sword": 200,
        "coal": 1600,
        "charcoal": 1600,
        "coal_block": 16000,
        "lava_bucket": 20000,
    },
)
