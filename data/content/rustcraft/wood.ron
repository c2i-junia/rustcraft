// Blocks and items of the base game, named as the commands name them. Every `*.ron` of this
// folder is read at start, and again once one is saved (or on `/reload`), by the server, which
// sends the content to its players; a set of files with an error changes nothing, and the error
// goes to the log and to the chat. The fields, and their defaults, are those of `BlockDef` and
// `ItemDef` in `shared/src/content/files.rs`. A block or an item is defined in one file only.
(
    blocks: {
        "oak_log": (break: 20, tools: [Axe], faces: (top: "OakLogTop", bottom: "OakLogTop")),
        "oak_planks": (break: 20, tools: [Axe]),
        "spruce_log": (break: 20, tools: [Axe], faces: (top: "SpruceLogTop", bottom: "SpruceLogTop")),
        "spruce_planks": (break: 20, tools: [Axe]),
        "jungle_log": (break: 20, tools: [Axe], faces: (top: "JungleLogTop", bottom: "JungleLogTop")),
        "jungle_planks": (break: 20, tools: [Axe]),
        "willow_log": (break: 20, tools: [Axe], faces: (top: "WillowLogTop", bottom: "WillowLogTop")),
        "willow_planks": (break: 20, tools: [Axe]),
        "acacia_log": (break: 20, tools: [Axe], faces: (top: "AcaciaLogTop", bottom: "AcaciaLogTop")),
        "acacia_planks": (break: 20, tools: [Axe]),
    },
    items: {
        "oak_log": (category: Wood),
        "oak_planks": (category: Wood),
        "spruce_log": (category: Wood),
        "spruce_planks": (category: Wood),
        "jungle_log": (category: Wood),
        "jungle_planks": (category: Wood),
        "willow_log": (category: Wood),
        "willow_planks": (category: Wood),
        "acacia_log": (category: Wood),
        "acacia_planks": (category: Wood),
    },
)
