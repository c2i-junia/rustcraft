// The recipes of the basics: what is made of wood, stone and the first finds. The recipes are
// tried in the order of the files, then of each file: these come first. The fields are those of
// `RecipeDef` in `shared/src/content/recipes.rs`.
(
    recipes: [
        (out: "oak_planks", count: 4, pattern: ["O"], key: {'O': "oak_log"}),
        (out: "spruce_planks", count: 4, pattern: ["S"], key: {'S': "spruce_log"}),
        (out: "jungle_planks", count: 4, pattern: ["J"], key: {'J': "jungle_log"}),
        (out: "stick", count: 4, pattern: ["P", "P"], key: {'P': "#planks"}),
        (out: "torch", count: 4, pattern: ["C", "S"], key: {'C': "coal", 'S': "stick"}),
        (out: "crafting_table", pattern: ["PP", "PP"], key: {'P': "#planks"}),
        (out: "furnace", pattern: ["CCC", "C C", "CCC"], key: {'C': "#cobble"}),
        (out: "chest", pattern: ["PPP", "P P", "PPP"], key: {'P': "#planks"}),
        (out: "wooden_pickaxe", pattern: ["PPP", " S ", " S "], key: {'P': "#planks", 'S': "stick"}),
        (out: "wooden_axe", pattern: ["PP", "PS", " S"], key: {'P': "#planks", 'S': "stick"}),
        (out: "wooden_shovel", pattern: ["P", "S", "S"], key: {'P': "#planks", 'S': "stick"}),
        (out: "wooden_hoe", pattern: ["PP", " S", " S"], key: {'P': "#planks", 'S': "stick"}),
        (out: "wooden_sword", pattern: ["P", "P", "S"], key: {'P': "#planks", 'S': "stick"}),
        (out: "stone_pickaxe", pattern: ["CCC", " S ", " S "], key: {'C': "#cobble", 'S': "stick"}),
        (out: "stone_axe", pattern: ["CC", "CS", " S"], key: {'C': "#cobble", 'S': "stick"}),
        (out: "stone_shovel", pattern: ["C", "S", "S"], key: {'C': "#cobble", 'S': "stick"}),
        (out: "stone_hoe", pattern: ["CC", " S", " S"], key: {'C': "#cobble", 'S': "stick"}),
        (out: "stone_sword", pattern: ["C", "C", "S"], key: {'C': "#cobble", 'S': "stick"}),
        (out: "iron_pickaxe", pattern: ["III", " S ", " S "], key: {'I': "iron_ingot", 'S': "stick"}),
        (out: "iron_axe", pattern: ["II", "IS", " S"], key: {'I': "iron_ingot", 'S': "stick"}),
        (out: "iron_shovel", pattern: ["I", "S", "S"], key: {'I': "iron_ingot", 'S': "stick"}),
        (out: "iron_hoe", pattern: ["II", " S", " S"], key: {'I': "iron_ingot", 'S': "stick"}),
        (out: "iron_sword", pattern: ["I", "I", "S"], key: {'I': "iron_ingot", 'S': "stick"}),
        (out: "golden_pickaxe", pattern: ["GGG", " S ", " S "], key: {'G': "gold_ingot", 'S': "stick"}),
        (out: "golden_axe", pattern: ["GG", "GS", " S"], key: {'G': "gold_ingot", 'S': "stick"}),
        (out: "golden_shovel", pattern: ["G", "S", "S"], key: {'G': "gold_ingot", 'S': "stick"}),
        (out: "golden_hoe", pattern: ["GG", " S", " S"], key: {'G': "gold_ingot", 'S': "stick"}),
        (out: "golden_sword", pattern: ["G", "G", "S"], key: {'G': "gold_ingot", 'S': "stick"}),
        (out: "diamond_pickaxe", pattern: ["DDD", " S ", " S "], key: {'D': "diamond", 'S': "stick"}),
        (out: "diamond_axe", pattern: ["DD", "DS", " S"], key: {'D': "diamond", 'S': "stick"}),
        (out: "diamond_shovel", pattern: ["D", "S", "S"], key: {'D': "diamond", 'S': "stick"}),
        (out: "diamond_hoe", pattern: ["DD", " S", " S"], key: {'D': "diamond", 'S': "stick"}),
        (out: "diamond_sword", pattern: ["D", "D", "S"], key: {'D': "diamond", 'S': "stick"}),
        (out: "iron_block", pattern: ["III", "III", "III"], key: {'I': "iron_ingot"}),
        (out: "gold_block", pattern: ["GGG", "GGG", "GGG"], key: {'G': "gold_ingot"}),
        (out: "diamond_block", pattern: ["DDD", "DDD", "DDD"], key: {'D': "diamond"}),
        (out: "iron_ingot", count: 9, pattern: ["I"], key: {'I': "iron_block"}),
        (out: "gold_ingot", count: 9, pattern: ["G"], key: {'G': "gold_block"}),
        (out: "diamond", count: 9, pattern: ["D"], key: {'D': "diamond_block"}),
        (out: "torch", count: 4, pattern: ["C", "S"], key: {'C': "charcoal", 'S': "stick"}),
        (out: "bucket", pattern: ["I I", " I "], key: {'I': "iron_ingot"}),
        (out: "willow_planks", count: 4, pattern: ["W"], key: {'W': "willow_log"}),
        (out: "acacia_planks", count: 4, pattern: ["A"], key: {'A': "acacia_log"}),
        (out: "hewn_stone", count: 2, pattern: ["S", "S"], key: {'S': "stone"}),
        (out: "brick_wall", pattern: ["FF", "FF"], key: {'F': "fired_brick"}),
        (out: "rammed_earth", count: 2, pattern: ["D", "D", "G"], key: {'D': "dirt", 'G': "gravel"}),
        (out: "thatch", pattern: ["FF", "FF"], key: {'F': "fiber"}),
        (out: "rope", count: 2, pattern: ["F", "F", "F"], key: {'F': "fiber"}),
        (out: "bronze_ingot", count: 4, pattern: ["CC", "CT"], key: {'C': "copper_ingot", 'T': "tin_ingot"}),
        (out: "coal_block", pattern: ["CCC", "CCC", "CCC"], key: {'C': "coal"}),
        (out: "coal", count: 9, pattern: ["C"], key: {'C': "coal_block"}),
        (out: "copper_block", pattern: ["CCC", "CCC", "CCC"], key: {'C': "copper_ingot"}),
        (out: "copper_ingot", count: 9, pattern: ["C"], key: {'C': "copper_block"}),
        (out: "tin_block", pattern: ["TTT", "TTT", "TTT"], key: {'T': "tin_ingot"}),
        (out: "tin_ingot", count: 9, pattern: ["T"], key: {'T': "tin_block"}),
        (out: "bronze_block", pattern: ["BBB", "BBB", "BBB"], key: {'B': "bronze_ingot"}),
        (out: "bronze_ingot", count: 9, pattern: ["B"], key: {'B': "bronze_block"}),
        (out: "hewn_stone_slab", count: 6, pattern: ["HHH"], key: {'H': "hewn_stone"}),
        (out: "brick_slab", count: 6, pattern: ["BBB"], key: {'B': "brick_wall"}),
        (out: "lantern", pattern: [" I ", "ITI", " I "], key: {'I': "iron_ingot", 'T': "torch"}),
        (out: "bronze_pickaxe", pattern: ["BBB", " S ", " S "], key: {'B': "bronze_ingot", 'S': "stick"}),
        (out: "bronze_axe", pattern: ["BB", "BS", " S"], key: {'B': "bronze_ingot", 'S': "stick"}),
        (out: "bronze_shovel", pattern: ["B", "S", "S"], key: {'B': "bronze_ingot", 'S': "stick"}),
        (out: "bronze_hoe", pattern: ["BB", " S", " S"], key: {'B': "bronze_ingot", 'S': "stick"}),
        (out: "bronze_sword", pattern: ["B", "B", "S"], key: {'B': "bronze_ingot", 'S': "stick"}),
        (out: "hewn_stone_stairs", count: 4, pattern: ["H ", "HH", "HH"], key: {'H': "hewn_stone"}),
        (out: "brick_stairs", count: 4, pattern: ["B ", "BB", "BB"], key: {'B': "brick_wall"}),
        (out: "ladder", count: 3, pattern: ["SRS", "SSS", " R "], key: {'S': "stick", 'R': "rope"}),
        (out: "fence", count: 3, pattern: ["SPS", "SPS"], key: {'S': "stick", 'P': "#planks"}),
        (out: "glass_pane", count: 8, pattern: ["GGG"], key: {'G': "glass"}),
        (out: "spear", pattern: ["FR", "S ", "S "], key: {'F': "flint", 'R': "rope", 'S': "stick"}),
        (out: "rye_bread", pattern: ["RRR"], key: {'R': "rye"}),
        (out: "bedroll", pattern: ["RRR", "O O"], key: {'R': "red_wool", 'O': "rope"}),
        (out: "barrel", pattern: ["PRP", "P P", "PRP"], key: {'P': "#planks", 'R': "rope"}),
        (out: "rain_cistern", pattern: ["H H", "HBH", "HHH"], key: {'H': "hewn_stone", 'B': "bucket"}),
        (out: "campfire", pattern: [" S ", "S S", "OOO"], key: {'S': "stick", 'O': "oak_log"}),
        (out: "campfire", pattern: [" S ", "S S", "PPP"], key: {'S': "stick", 'P': "spruce_log"}),
        (out: "campfire", pattern: [" S ", "S S", "JJJ"], key: {'S': "stick", 'J': "jungle_log"}),
        (out: "campfire", pattern: [" S ", "S S", "WWW"], key: {'S': "stick", 'W': "willow_log"}),
        (out: "campfire", pattern: [" S ", "S S", "AAA"], key: {'S': "stick", 'A': "acacia_log"}),
        (out: "sign", pattern: ["PPP", "PPP", " S "], key: {'P': "#planks", 'S': "stick"}),
        (out: "portal_gun", pattern: ["GII", " OI", "  S"], key: {'G': "glass", 'I': "iron_ingot", 'O': "gold_ingot", 'S': "stick"}),
        (out: "flint_and_steel", shapeless: ["iron_ingot", "flint"]),
        (out: "engraving_table", pattern: ["CDC", "HOH", "H H"], key: {'C': "copper_ingot", 'D': "diamond", 'H': "hewn_stone", 'O': "obsidian"}),
        (out: "anvil", pattern: ["III", " R ", "RRR"], key: {'I': "iron_block", 'R': "iron_ingot"}),
        (out: "boat", pattern: ["P P", "PPP"], key: {'P': "#planks"}),
        (out: "saddle", pattern: ["LLL", "RIR"], key: {'L': "leather", 'R': "rope", 'I': "iron_ingot"}),
        (out: "lead", count: 2, pattern: ["RR ", "RL ", "  R"], key: {'R': "rope", 'L': "leather"}),
        (out: "leather_horse_armour", pattern: ["L L", "LLL", "L L"], key: {'L': "leather"}),
        (out: "iron_horse_armour", pattern: ["I I", "ILI", "I I"], key: {'I': "iron_ingot", 'L': "leather"}),
        (out: "gold_horse_armour", pattern: ["G G", "GLG", "G G"], key: {'G': "gold_ingot", 'L': "leather"}),
        (out: "diamond_horse_armour", pattern: ["D D", "DLD", "D D"], key: {'D': "diamond", 'L': "leather"}),
        (out: "shield", pattern: ["PIP", "PPP", " P "], key: {'P': "#planks", 'I': "iron_ingot"}),
        (out: "crossbow", pattern: ["SIS", "RIR", " S "], key: {'S': "stick", 'I': "iron_ingot", 'R': "rope"}),
        (out: "bolt", count: 8, pattern: ["I", "S", "F"], key: {'I': "iron_ingot", 'S': "stick", 'F': "feather"}),
        (out: "throwing_axe", count: 4, pattern: ["II", " S"], key: {'I': "iron_ingot", 'S': "stick"}),
        (out: "mace", pattern: ["II", "II", " S"], key: {'I': "iron_ingot", 'S': "stick"}),
        (out: "leather_helmet", pattern: ["LLL", "L L"], key: {'L': "leather"}),
        (out: "leather_chestplate", pattern: ["L L", "LLL", "LLL"], key: {'L': "leather"}),
        (out: "leather_leggings", pattern: ["LLL", "L L", "L L"], key: {'L': "leather"}),
        (out: "leather_boots", pattern: ["L L", "L L"], key: {'L': "leather"}),
        (out: "bronze_helmet", pattern: ["BBB", "B B"], key: {'B': "bronze_ingot"}),
        (out: "bronze_chestplate", pattern: ["B B", "BBB", "BBB"], key: {'B': "bronze_ingot"}),
        (out: "bronze_leggings", pattern: ["BBB", "B B", "B B"], key: {'B': "bronze_ingot"}),
        (out: "bronze_boots", pattern: ["B B", "B B"], key: {'B': "bronze_ingot"}),
        (out: "iron_helmet", pattern: ["III", "I I"], key: {'I': "iron_ingot"}),
        (out: "iron_chestplate", pattern: ["I I", "III", "III"], key: {'I': "iron_ingot"}),
        (out: "iron_leggings", pattern: ["III", "I I", "I I"], key: {'I': "iron_ingot"}),
        (out: "iron_boots", pattern: ["I I", "I I"], key: {'I': "iron_ingot"}),
        (out: "diamond_helmet", pattern: ["DDD", "D D"], key: {'D': "diamond"}),
        (out: "diamond_chestplate", pattern: ["D D", "DDD", "DDD"], key: {'D': "diamond"}),
        (out: "diamond_leggings", pattern: ["DDD", "D D", "D D"], key: {'D': "diamond"}),
        (out: "diamond_boots", pattern: ["D D", "D D"], key: {'D': "diamond"}),
        (out: "bow", pattern: ["SS ", "R S", "SS "], key: {'S': "stick", 'R': "rope"}),
        (out: "arrow", count: 4, pattern: ["F", "S", "E"], key: {'F': "flint", 'S': "stick", 'E': "feather"}),
        (out: "depths_compass", pattern: [" G ", "GDG", " G "], key: {'G': "gold_ingot", 'D': "diamond"}),
        (out: "fishing_rod", pattern: ["  S", " SR", "S R"], key: {'S': "stick", 'R': "rope"}),
        (out: "bowl", count: 4, pattern: ["P P", " P "], key: {'P': "#planks"}),
        (out: "mushroom_soup", shapeless: ["bowl", "mushroom", "mushroom"]),
        (out: "stew", shapeless: ["bowl", "carrot", "potato", "mushroom", "#roast_meat"]),
        (out: "berry_salad", shapeless: ["bowl", "berries", "berries", "apple"]),
        (out: "fish_chowder", shapeless: ["bowl", "milk_bucket", "#raw_fish", "potato"]),
        (out: "cake_batter", shapeless: ["milk_bucket", "egg", "cocoa_beans", "rye", "rye"]),
        (out: "raw_pie", shapeless: ["apple", "apple", "egg", "rye"]),
        (out: "compost", count: 2, shapeless: ["fiber", "fiber", "dirt"]),
        (out: "glowcrystal", pattern: ["CC", "CC"], key: {'C': "crystal_shard"}),
        (out: "polished_basalt", count: 4, pattern: ["BB", "BB"], key: {'B': "basalt"}),
        (out: "paper", count: 2, pattern: ["KKK"], key: {'K': "kelp"}),
    ],
)
