// The spawn eggs, and the kinds of mobs: their numbers, how they are drawn and heard. Every
// `*.ron` of this folder is read at start, and again once one is saved (or on `/reload`), by the
// server, which sends the content to its players; a set of files with an error changes nothing,
// and the error goes to the log and to the chat. The fields of an item are those of `ItemDef`
// in `shared/src/content/files.rs`, those of a mob those of `MobDef` in
// `shared/src/content/mobs.rs`. Every kind of `MobKind` has its entry, and only those: a new
// kind is a change to the Rust code, which gives it its behaviour.
//
// A mob: `health` in points; `size` the width, height and depth of its box, in blocks;
// `walk_speed` in blocks/s; `hunt` (blocks, blocks, blocks/s) and `strike` (points, blocks,
// ticks, blocks/s) for a hostile; the points of `experience` it leaves; whether it is
// `tameable` by feeding it what it `eats`; the lines of its `drops`, one item by default; its
// `model` and the `clips` of the model in the order of its animations (the exporter sorts them
// by name); the `lift` of the bottom of its box above the origin of its model, in metres; the
// folder of its `sounds` in `sounds/mob/`.
(
    items: {
        "fox_spawn_egg": (spawned_mob: Fox, category: Mobs),
        "sheep_spawn_egg": (spawned_mob: Sheep, category: Mobs),
        "cow_spawn_egg": (spawned_mob: Cow, category: Mobs),
        "pig_spawn_egg": (spawned_mob: Pig, category: Mobs),
        "chicken_spawn_egg": (spawned_mob: Chicken, category: Mobs),
        "rabbit_spawn_egg": (spawned_mob: Rabbit, category: Mobs),
        "wolf_spawn_egg": (spawned_mob: Wolf, category: Mobs),
        "horse_spawn_egg": (spawned_mob: Horse, category: Mobs),
        "goat_spawn_egg": (spawned_mob: Goat, category: Mobs),
        "cat_spawn_egg": (spawned_mob: Cat, category: Mobs),
        "gnawer_spawn_egg": (spawned_mob: Gnawer, category: Mobs),
        "bramble_spawn_egg": (spawned_mob: Bramble, category: Mobs),
        "roller_spawn_egg": (spawned_mob: Roller, category: Mobs),
        "stumpling_spawn_egg": (spawned_mob: Stumpling, category: Mobs),
        "drowner_spawn_egg": (spawned_mob: Drowner, category: Mobs),
        "cinderling_spawn_egg": (spawned_mob: Cinderling, category: Mobs),
        "gust_owl_spawn_egg": (spawned_mob: GustOwl, category: Mobs),
        "farmer_spawn_egg": (spawned_mob: Farmer, category: Mobs),
        "smith_spawn_egg": (spawned_mob: Smith, category: Mobs),
        "cartographer_spawn_egg": (spawned_mob: Cartographer, category: Mobs),
        "glintfin_spawn_egg": (spawned_mob: Glintfin, category: Mobs),
        "shoalback_spawn_egg": (spawned_mob: Shoalback, category: Mobs),
        "mossback_spawn_egg": (spawned_mob: Mossback, category: Mobs),
        "shardling_spawn_egg": (spawned_mob: Shardling, category: Mobs),
        "slagcrawler_spawn_egg": (spawned_mob: Slagcrawler, category: Mobs),
        "donkey_spawn_egg": (spawned_mob: Donkey, category: Mobs),
        "mule_spawn_egg": (spawned_mob: Mule, category: Mobs),
    },
    mobs: {
        "fox": (
            health: 10,
            size: (0.7, 0.7, 0.7),
            walk_speed: 1.6,
            eats: ["berries"],
            model: "models/animated/Fox.glb",
            clips: [Idle, Run, Walk],
            sounds: "fox",
        ),
        "sheep": (
            health: 8,
            size: (0.9, 1.25, 0.9),
            walk_speed: 1.0,
            eats: ["rye"],
            drops: [
                (item: "raw_mutton", count: Range(1, 2)),
                (item: "wool", when: NotSheared),
            ],
            model: "models/animated/Sheep.glb",
            clips: [Eat, Idle, Walk],
            sounds: "sheep",
        ),
        "cow": (
            health: 12,
            size: (0.9, 1.4, 0.9),
            walk_speed: 1.0,
