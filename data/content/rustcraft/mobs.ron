            size: (0.6, 0.6, 0.6),
            walk_speed: 1.4,
            hunt: (sight: 16.0, forget: 24.0, speed: 2.8),
            strike: (damage: 2, reach: 1.0, cooldown: 15, knock_back: 0.0),
            experience: 3,
            // A part of the creature, which distils into strength (`alchemy`)
