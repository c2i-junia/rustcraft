        "drowner": (
            health: 18,
            // 1.0 wide with its arms, 1.56 tall
            size: (0.8, 1.5, 0.8),
            walk_speed: 0.8,
            // Its speed in water: it walks at 0.8 on land, only back to the water
            hunt: (sight: 16.0, forget: 24.0, speed: 3.0),
