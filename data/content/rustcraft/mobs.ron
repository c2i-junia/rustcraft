            tameable: true,
            eats: ["raw_chicken", "raw_rabbit"],
            model: "models/animated/Cat.glb",
            clips: [Idle, Run, Walk],
            sounds: "cat",
        ),
        "gnawer": (
            health: 6,
            // The models of `scripts/generate_hostiles.py`: the Gnawer is 0.375 wide and 0.625 tall
