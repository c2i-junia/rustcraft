        "stumpling": (
            health: 24,
            // 1.125 wide with its arms, 2.06 tall: its box fits the two free cells of a spawn
            size: (0.9, 1.95, 0.9),
            walk_speed: 0.8,
            hunt: (sight: 16.0, forget: 24.0, speed: 1.2),
            strike: (damage: 3, reach: 1.2, cooldown: 20, knock_back: 0.0),
            experience: 5,
            drops: [
                (item: "stick", count: Range(2, 4)),
