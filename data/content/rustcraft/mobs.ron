                (item: "leather", count: Range(0, 2)),
            ],
            model: "models/animated/Cow.glb",
            clips: [Eat, Idle, Run, Walk],
            sounds: "cow",
        ),
        "pig": (
            health: 10,
            size: (0.9, 0.9, 0.9),
            walk_speed: 1.0,
            eats: ["carrot", "potato"],
            drops: [
