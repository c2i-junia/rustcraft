// Blocks and items of the base game, named as the commands name them. Every `*.ron` of this
// folder is read at start, and again once one is saved (or on `/reload`), by the server, which
// sends the content to its players; a set of files with an error changes nothing, and the error
// goes to the log and to the chat. The fields, and their defaults, are those of `BlockDef` and
// `ItemDef` in `shared/src/content/files.rs`. A block or an item is defined in one file only.
//
// The palette of the builder: the logs and planks of each wood with their slabs, stairs, doors,
// trapdoors and fence gates, and the slabs, stairs, low walls, polished and chiseled blocks of each
// rock. Each family is written once for its members (`shared/src/content/families.rs`): a new
// wood is a word in the list of the woods, and its textures (`<Wood>Log`, `<Wood>LogTop`,
// `<Wood>Planks`, `<Wood>Door`, `<Wood>DoorTop`, `<Wood>Trapdoor`), and nothing else: the recipe
// of its planks is the family's too. The five woods that are older write that recipe in
// `crafting.ron`, which the family then leaves out, to keep it where it was. The recipes of the families follow those
// of `crafting.ron` and come before those of `palette_dyes.ron`, in the order the item browser
// numbers them, which is why they are in files of these names.
(
    blocks: {
        // older than the palette, and not as the others of their families are
        "oak_slab": (palette: (form: Slab, base: "oak_planks", item: "oak_slab"), look: Decoration, break: 16, tools: [Axe], collision: Aabb((min: (0, 0, 0), max: (1, 0.5, 1))), faces: (all: "OakPlanks"), aliases: ["wooden_slab"]),
        "oak_stairs": (palette: (form: Stairs, base: "oak_planks", item: "oak_stairs"), look: Decoration, break: 16, tools: [Axe], collision: Aabb((min: (0, 0, 0), max: (1, 0.5, 1))), outline: FullBlock, faces: (all: "OakPlanks"), aliases: ["wooden_stairs"]),
        "door": (palette: (form: Door(top: false, open: false), base: "oak_planks", item: "door"), look: Decoration, break: 16, tools: [Axe], collision: Aabb((min: (0, 0, 0), max: (1, 1, 0.1875))), usable: true, top: "door_top", toggled: "open_door", aliases: ["oak_door"]),
        "door_top": (palette: (form: Door(top: true, open: false), base: "oak_planks", item: "door"), look: Decoration, break: 16, tools: [Axe], drops: [(1, "door", 1)], collision: Aabb((min: (0, 0, 0), max: (1, 1, 0.1875))), usable: true, toggled: "open_door_top", aliases: ["oak_door_top"]),
        "open_door": (palette: (form: Door(top: false, open: true), base: "oak_planks", item: "door"), look: Decoration, break: 16, tools: [Axe], drops: [(1, "door", 1)], collision: None, outline: Aabb((min: (0, 0, 0), max: (0.1875, 1, 1))), usable: true, faces: (all: "Door"), toggled: "door", aliases: ["open_oak_door"]),
        "open_door_top": (palette: (form: Door(top: true, open: true), base: "oak_planks", item: "door"), look: Decoration, break: 16, tools: [Axe], drops: [(1, "door", 1)], collision: None, outline: Aabb((min: (0, 0, 0), max: (0.1875, 1, 1))), usable: true, faces: (all: "DoorTop"), toggled: "door_top", aliases: ["open_oak_door_top"]),
        "hewn_stone_slab": (palette: (form: Slab, base: "hewn_stone", item: "hewn_stone_slab"), look: Decoration, break: 20, tools: [Pickaxe], needs_tool: (kind: Pickaxe, level: 0), collision: Aabb((min: (0, 0, 0), max: (1, 0.5, 1))), faces: (all: "HewnStone")),
        "hewn_stone_stairs": (palette: (form: Stairs, base: "hewn_stone", item: "hewn_stone_stairs"), look: Decoration, break: 16, tools: [Pickaxe], needs_tool: (kind: Pickaxe, level: 0), collision: Aabb((min: (0, 0, 0), max: (1, 0.5, 1))), outline: FullBlock, faces: (all: "HewnStone")),
        "brick_slab": (palette: (form: Slab, base: "brick_wall", item: "brick_slab"), look: Decoration, break: 20, tools: [Pickaxe], needs_tool: (kind: Pickaxe, level: 0), collision: Aabb((min: (0, 0, 0), max: (1, 0.5, 1))), faces: (all: "BrickWall")),
        "brick_stairs": (palette: (form: Stairs, base: "brick_wall", item: "brick_stairs"), look: Decoration, break: 16, tools: [Pickaxe], needs_tool: (kind: Pickaxe, level: 0), collision: Aabb((min: (0, 0, 0), max: (1, 0.5, 1))), outline: FullBlock, faces: (all: "BrickWall")),
    },
    families: [
        // the woods: what is made of the planks breaks as they do
        (
            each: {"w": ["oak", "spruce", "jungle", "willow", "acacia"]},
            blocks: {
                "{w}_log": (break: 20, tools: [Axe], faces: (top: "{W}LogTop", bottom: "{W}LogTop")),
                "{w}_planks": (break: 20, tools: [Axe]),
                "{w}_slab": (like: "{w}_planks", palette: (form: Slab, base: "{w}_planks", item: "{w}_slab"), look: Decoration, collision: Aabb((min: (0, 0, 0), max: (1, 0.5, 1))), faces: (all: "{W}Planks")),
                "{w}_stairs": (like: "{w}_planks", palette: (form: Stairs, base: "{w}_planks", item: "{w}_stairs"), look: Decoration, collision: Aabb((min: (0, 0, 0), max: (1, 0.5, 1))), outline: FullBlock, faces: (all: "{W}Planks")),
                "{w}_door": (like: "{w}_planks", palette: (form: Door(top: false, open: false), base: "{w}_planks", item: "{w}_door"), look: Decoration, collision: Aabb((min: (0, 0, 0), max: (1, 1, 0.1875))), usable: true, top: "{w}_door_top", toggled: "open_{w}_door"),
                "{w}_door_top": (like: "{w}_planks", palette: (form: Door(top: true, open: false), base: "{w}_planks", item: "{w}_door"), look: Decoration, drops: [(1, "{w}_door", 1)], collision: Aabb((min: (0, 0, 0), max: (1, 1, 0.1875))), usable: true, toggled: "open_{w}_door_top"),
                "open_{w}_door": (like: "{w}_planks", palette: (form: Door(top: false, open: true), base: "{w}_planks", item: "{w}_door"), look: Decoration, drops: [(1, "{w}_door", 1)], collision: None, outline: Aabb((min: (0, 0, 0), max: (0.1875, 1, 1))), usable: true, faces: (all: "{W}Door"), toggled: "{w}_door"),
                "open_{w}_door_top": (like: "{w}_planks", palette: (form: Door(top: true, open: true), base: "{w}_planks", item: "{w}_door"), look: Decoration, drops: [(1, "{w}_door", 1)], collision: None, outline: Aabb((min: (0, 0, 0), max: (0.1875, 1, 1))), usable: true, faces: (all: "{W}DoorTop"), toggled: "{w}_door_top"),
                "{w}_trapdoor": (like: "{w}_planks", palette: (form: Trapdoor(open: false), base: "{w}_planks", item: "{w}_trapdoor"), look: Decoration, collision: Aabb((min: (0, 0, 0), max: (1, 0.1875, 1))), usable: true, toggled: "open_{w}_trapdoor"),
                "open_{w}_trapdoor": (like: "{w}_planks", palette: (form: Trapdoor(open: true), base: "{w}_planks", item: "{w}_trapdoor"), look: Decoration, drops: [(1, "{w}_trapdoor", 1)], collision: Aabb((min: (0, 0, 0), max: (1, 1, 0.1875))), usable: true, faces: (all: "{W}Trapdoor"), toggled: "{w}_trapdoor"),
                "{w}_fence_gate": (like: "{w}_planks", palette: (form: FenceGate(open: false), base: "{w}_planks", item: "{w}_fence_gate"), look: Decoration, collision: Aabb((min: (0, 0, 0.375), max: (1, 1.5, 0.625))), outline: Aabb((min: (0, 0, 0.375), max: (1, 1, 0.625))), usable: true, tall: true, faces: (all: "{W}Planks"), toggled: "open_{w}_fence_gate"),
                "open_{w}_fence_gate": (like: "{w}_planks", palette: (form: FenceGate(open: true), base: "{w}_planks", item: "{w}_fence_gate"), look: Decoration, drops: [(1, "{w}_fence_gate", 1)], collision: None, outline: Aabb((min: (0, 0, 0.375), max: (1, 1, 0.625))), usable: true, faces: (all: "{W}Planks"), toggled: "{w}_fence_gate"),
            },
            items: {
                "{w}_log": (category: Wood),
                "{w}_planks": (category: Wood),
            },
            tags: {"planks": ["{w}_planks"]},
            recipes: [
                (out: "{w}_planks", count: 4, pattern: ["L"], key: {'L': "{w}_log"}),
                (out: "{w}_slab", count: 6, pattern: ["PPP"], key: {'P': "{w}_planks"}),
                (out: "{w}_stairs", count: 4, pattern: ["P ", "PP", "PP"], key: {'P': "{w}_planks"}),
                (out: "{w}_door", pattern: ["PP", "PP", "PP"], key: {'P': "{w}_planks"}),
                (out: "{w}_trapdoor", count: 2, pattern: ["PPP", "PPP"], key: {'P': "{w}_planks"}),
                (out: "{w}_fence_gate", pattern: ["PSP", "PSP"], key: {'P': "{w}_planks", 'S': "stick"}),
            ],
            smelting: [("{w}_log", "charcoal")],
            fuel: {"{w}_log": 300, "{w}_slab": 150, "{w}_stairs": 300, "{w}_door": 300, "{w}_trapdoor": 300, "{w}_fence_gate": 300},
        ),
        // the rocks, `r`, cut from the block `m`, which they break as
        (
            each: {
                "r": ["stone", "cobblestone", "hewn_stone", "limestone", "slate", "brick", "gloomrock", "cobbled_gloomrock"],
                "m": ["stone", "cobblestone", "hewn_stone", "limestone", "slate", "brick_wall", "gloomrock", "cobbled_gloomrock"],
            },
            except: [
                "hewn_stone_slab", "hewn_stone_stairs", "brick_slab", "brick_stairs",
                "polished_cobblestone", "chiseled_cobblestone", "polished_hewn_stone", "chiseled_hewn_stone",
                "polished_brick", "chiseled_brick", "polished_cobbled_gloomrock", "chiseled_cobbled_gloomrock",
            ],
            blocks: {
                "{r}_slab": (like: "{m}", palette: (form: Slab, base: "{m}", item: "{r}_slab"), look: Decoration, drops: [(1, "{r}_slab", 1)], collision: Aabb((min: (0, 0, 0), max: (1, 0.5, 1))), faces: (all: "{M}")),
                "{r}_stairs": (like: "{m}", palette: (form: Stairs, base: "{m}", item: "{r}_stairs"), look: Decoration, drops: [(1, "{r}_stairs", 1)], collision: Aabb((min: (0, 0, 0), max: (1, 0.5, 1))), outline: FullBlock, faces: (all: "{M}")),
                "{r}_low_wall": (like: "{m}", palette: (form: LowWall, base: "{m}", item: "{r}_low_wall"), look: Decoration, drops: [(1, "{r}_low_wall", 1)], collision: Aabb((min: (0, 0, 0), max: (1, 1.5, 1))), outline: FullBlock, tall: true, faces: (all: "{M}")),
                "polished_{r}": (like: "{m}", palette: (form: Cube, base: "{m}", item: "polished_{r}"), drops: [(1, "polished_{r}", 1)]),
                "chiseled_{r}": (like: "{m}", palette: (form: Cube, base: "{m}", item: "chiseled_{r}"), drops: [(1, "chiseled_{r}", 1)]),
            },
            recipes: [
                (out: "{r}_slab", count: 6, pattern: ["MMM"], key: {'M': "{m}"}),
                (out: "{r}_stairs", count: 4, pattern: ["M ", "MM", "MM"], key: {'M': "{m}"}),
                (out: "{r}_low_wall", count: 6, pattern: ["MMM", "MMM"], key: {'M': "{m}"}),
                (out: "polished_{r}", count: 4, pattern: ["MM", "MM"], key: {'M': "{m}"}),
                (out: "chiseled_{r}", pattern: ["S", "S"], key: {'S': "{r}_slab"}),
            ],
        ),
    ],
)
