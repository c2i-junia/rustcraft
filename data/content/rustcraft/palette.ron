    blocks: {
        "oak_slab": (palette: (form: Slab, base: "oak_planks", item: "oak_slab"), look: Decoration, break: 16, tools: [Axe], collision: Aabb((min: (0, 0, 0), max: (1, 0.5, 1)))),
