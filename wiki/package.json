{
	"name": "rustcraft-wiki",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "bun scripts/textures.ts && vite dev",
		"build": "bun scripts/textures.ts && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"textures": "bun scripts/textures.ts",
		"data": "cd .. && cargo run -q -p shared --example wiki_export -- wiki/src/lib/data/game.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@fontsource/pixelify-sans": "^5.3.0"
	}
}
