		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@fontsource/pixelify-sans": "^5.3.0",
		"@ui-sdk/core": "0.1.0-beta.17",
		"@ui-sdk/svelte": "0.1.0-beta.17"
	}
}
